  <property name="styleSheet">
   <string notr="true">QDialog#GeokodowanieAdresowDialogBase { background-color: #ffffff; }
QLabel { background: transparent; color: #2b2b2b; font-size: 8pt; }
QCheckBox { background: transparent; color: #2b2b2b; font-size: 9pt; spacing: 6px; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid #9aa79a; border-radius: 3px; background-color: #ffffff; }
QCheckBox::indicator:hover { border-color: #4c6e4f; }
QCheckBox::indicator:checked { background-color: #4c6e4f; border: 1px solid #4c6e4f; image: url(geokodowanieimg:check.svg); }
QCheckBox::indicator:checked:hover { background-color: #5a7f5d; border-color: #5a7f5d; }

/* ---------- NAGŁÓWEK ---------- */
QFrame#headerFrame { background-color: #ffffff; border: none; border-bottom: 2px solid #3d5a2a; }
QLabel#lbl_title { color: #3d5a2a; font-size: 12pt; font-weight: bold; }
QLabel#lbl_pluginVersion { color: #6b6b6b; font-size: 8pt; }
QToolButton#btn_help { background: transparent; border: none; border-radius: 12px; padding: 0px; }
QToolButton#btn_help:hover { background-color: #e4e9dc; }

/* ---------- KARTY ---------- */
QFrame[card=&quot;true&quot;] { background-color: #ffffff; border: 1px solid #d6ded6; border-radius: 6px; }
QLabel[cardTitle=&quot;true&quot;] {
    font-size: 9pt; font-weight: bold; padding: 5px 8px; border: none;
    border-top-left-radius: 5px; border-top-right-radius: 5px;
}
QLabel#lbl_cardFiles { background-color: #b9c7ba; color: #232829; }
QLabel#lbl_cardCsv { background-color: #d6ded5; color: #23282a; }
QLabel#lbl_cardColumns { background-color: #e8efe8; color: #3b5a3e; }
QLabel[caption=&quot;true&quot;] { color: #2b2b2b; font-weight: bold; }
QLabel[hint=&quot;true&quot;] { color: #8a8a8a; font-size: 7pt; }

/* ---------- POLA ---------- */
QComboBox {
    background-color: #fbfbfb; color: #2b2b2b; font-size: 9pt;
    border: 1px solid #c4c8c4; border-radius: 3px; padding: 2px 6px; min-height: 18px;
}
QComboBox:hover, QComboBox:focus { border-color: #4c6e4f; }
QComboBox:disabled { background-color: #f3f3f3; color: #a0a0a0; border-color: #e0e0e0; }
QComboBox QAbstractItemView {
    background-color: #ffffff; color: #2b2b2b; border: 1px solid #c4c8c4;
    selection-background-color: #e4e9dc; selection-color: #2b2b2b; outline: none;
}
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 18px; border: none; background: transparent;
}
QComboBox::down-arrow { image: url(geokodowanieimg:spin_down.svg); width: 12px; height: 12px; }
QgsFileWidget QLineEdit {
    background-color: #ffffff; color: #2b2b2b; font-size: 9pt;
    border: 1px solid #c4c8c4; border-radius: 3px; padding: 2px 4px; min-height: 18px;
}
QgsFileWidget QLineEdit:hover, QgsFileWidget QLineEdit:focus { border-color: #4c6e4f; }
QgsFileWidget QToolButton {
    background-color: #f5f5f5; color: #555555; font-size: 8pt;
    border: 1px solid #c4c8c4; border-radius: 3px; padding: 2px 6px; min-height: 18px;
}
QgsFileWidget QToolButton:hover { background-color: #eef3ee; border-color: #4c6e4f; }
QgsFileWidget QToolButton:pressed { background-color: #e4e9dc; }

/* ---------- STATUS I PRZYCISKI ---------- */
QLabel#lbl_status { color: #A2A2A2; font-size:10pt; font-weight: bold; }
QLabel#lbl_status[state=&quot;info&quot;] { color: #6b6b6b; }
QLabel#lbl_status[state=&quot;ok&quot;] { color: #3b5a3e; } 
QPushButton#btnGeokoduj {
    background-color: #4c6e4f; color: #ffffff; font-size: 9pt; font-weight: bold;
    border: 1px solid #4c6e4f; border-radius: 4px; padding: 5px 14px; min-height: 18px;
}
QPushButton#btnGeokoduj:hover { background-color: #5a7f5d; border-color: #5a7f5d; }
QPushButton#btnGeokoduj:pressed { background-color: #3d5a40; }
QPushButton#btnGeokoduj:disabled { background-color: #c9d3c9; border-color: #c9d3c9; color: #f4f6f4; }
QDialogButtonBox QPushButton {
    background-color: #ffffff; color: #2b2b2b; font-size: 9pt;
    border: 1px solid #c4c8c4; border-radius: 4px; padding: 5px 12px; min-height: 18px; min-width: 60px;
}
QDialogButtonBox QPushButton:hover { background-color: #f6f8f6; border-color: #4c6e4f; }
QDialogButtonBox QPushButton:pressed { background-color: #e4e9dc; }

/* ---------- STOPKA ---------- */
QFrame#footerFrame { background-color: #f6f8f6; border: none; border-top: 1px solid #dde3dd; }
QLabel#lbl_email_2, QLabel#lbl_szkolenia_2 { font-size: 8pt; padding: 2px 2px; }
QLabel#lbl_copyrights { color: #8a8a8a; font-size: 7pt; }

/* ---------- MOTYW CIEMNY ---------- */
QDialog#GeokodowanieAdresowDialogBase[theme=&quot;dark&quot;] { background-color: #2b2d2e; }
QDialog[theme=&quot;dark&quot;] QLabel { color: #e6e9e7; }
QDialog[theme=&quot;dark&quot;] QCheckBox { color: #e6e9e7; }
QDialog[theme=&quot;dark&quot;] QCheckBox::indicator { background-color: #1f2021; border: 1px solid #6f7773; }
QDialog[theme=&quot;dark&quot;] QCheckBox::indicator:hover { border-color: #7fae83; }
QDialog[theme=&quot;dark&quot;] QCheckBox::indicator:checked { background-color: #7fae83; border: 1px solid #7fae83; }
QDialog[theme=&quot;dark&quot;] QCheckBox::indicator:checked:hover { background-color: #8fbf92; border-color: #8fbf92; }

QDialog[theme=&quot;dark&quot;] QFrame#headerFrame { background-color: #303334; border-bottom: 2px solid #4c6e4f; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_title { color: #a9cfac; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_pluginVersion { color: #9aa4a0; }
QDialog[theme=&quot;dark&quot;] QToolButton#btn_help:hover { background-color: #3a3f40; }

QDialog[theme=&quot;dark&quot;] QFrame[card=&quot;true&quot;] { background-color: #262829; border: 1px solid #3e4a40; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_cardFiles { background-color: #4c6e4f; color: #ffffff; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_cardCsv { background-color: #3d5a40; color: #e6e9e7; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_cardColumns { background-color: #2c3a2d; color: #a9cfac; }
QDialog[theme=&quot;dark&quot;] QLabel[caption=&quot;true&quot;] { color: #e6e9e7; }
QDialog[theme=&quot;dark&quot;] QLabel[hint=&quot;true&quot;] { color: #8a918e; }

QDialog[theme=&quot;dark&quot;] QComboBox { background-color: #565656; color: #f0f0f0; border: 1px solid #565656; }
QDialog[theme=&quot;dark&quot;] QComboBox:hover, QDialog[theme=&quot;dark&quot;] QComboBox:focus { border-color: #7fae83; }
QDialog[theme=&quot;dark&quot;] QComboBox:disabled { background-color: #3a3d3e; color: #7a7f7c; border-color: #3a3d3e; }
QDialog[theme=&quot;dark&quot;] QComboBox QAbstractItemView { background-color: #2f3132; color: #e6e9e7; border: 1px solid #4a4f50; selection-background-color: #4c6e4f; selection-color: #ffffff; }
QDialog[theme=&quot;dark&quot;] QgsFileWidget QLineEdit { background-color: #1f2021; color: #e6e9e7; border: 1px solid #1f2021; }
QDialog[theme=&quot;dark&quot;] QgsFileWidget QLineEdit:hover, QDialog[theme=&quot;dark&quot;] QgsFileWidget QLineEdit:focus { border-color: #7fae83; }
QDialog[theme=&quot;dark&quot;] QgsFileWidget QToolButton { background-color: #565656; color: #e6e9e7; border: 1px solid #565656; }
QDialog[theme=&quot;dark&quot;] QgsFileWidget QToolButton:hover { background-color: #626262; border-color: #7fae83; }
QDialog[theme=&quot;dark&quot;] QgsFileWidget QToolButton:pressed { background-color: #4a4a4a; }

QDialog[theme=&quot;dark&quot;] QLabel#lbl_status { color: #a9cfac; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_status[state=&quot;info&quot;] { color: #9aa4a0; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_status[state=&quot;error&quot;] { color: #e8877c; }
QDialog[theme=&quot;dark&quot;] QPushButton#btnGeokoduj { background-color: #6f9c73; border-color: #6f9c73; color: #ffffff; }
QDialog[theme=&quot;dark&quot;] QPushButton#btnGeokoduj:hover { background-color: #7fae83; border-color: #7fae83; }
QDialog[theme=&quot;dark&quot;] QPushButton#btnGeokoduj:pressed { background-color: #5a8a5e; }
QDialog[theme=&quot;dark&quot;] QPushButton#btnGeokoduj:disabled { background-color: #3a3f40; border-color: #3a3f40; color: #6f7773; }
QDialog[theme=&quot;dark&quot;] QDialogButtonBox QPushButton { background-color: #2b2d2e; color: #e6e9e7; border: 1px solid #5a6162; }
QDialog[theme=&quot;dark&quot;] QDialogButtonBox QPushButton:hover { background-color: #33383a; border-color: #7fae83; }
QDialog[theme=&quot;dark&quot;] QDialogButtonBox QPushButton:pressed { background-color: #1f2a20; }

QDialog[theme=&quot;dark&quot;] QFrame#footerFrame { background-color: #303334; border-top: 1px solid #3e4244; }
QDialog[theme=&quot;dark&quot;] QLabel#lbl_copyrights { color: #8a918e; }</string>
